{
	"name": "subarulink",
	"image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"initializeCommand": "mkdir -p ${localWorkspaceFolder}/.devcontainer/subarulink-config",
	"mounts": [
		"source=${localWorkspaceFolder}/.devcontainer/subarulink-config,target=/home/vscode/.config/subarulink,type=bind"
	],
	"containerEnv": {
		"PIPENV_VENV_IN_PROJECT": "1",
		"GIT_EDITOR": "code --wait"
	},
	"remoteEnv": {
		"VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
		"PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
	},
	"postCreateCommand": "pipx install pipenv && pipenv sync --dev",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.black-formatter",
				"charliermarsh.ruff",
				"ms-python.mypy-type-checker"
			],
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"ruff.lint.select": [
					"I"
				],
				"python.testing.pytestEnabled": true,
				"python.testing.pytestArgs": [
					"--no-cov"
				],
				"editor.formatOnSave": true,
				"files.trimTrailingWhitespace": true,
				"[python]": {
					"editor.defaultFormatter": "ms-python.black-formatter",
					"editor.codeActionsOnSave": {
						"source.organizeImports.ruff": "explicit"
					}
				},
				"terminal.integrated.defaultProfile.linux": "zsh"
			}
		}
	}
}
